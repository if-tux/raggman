# Local development (`make dev`). Inside docker compose these are set by the compose file.
# Do not set LLM_BASE_URL or OLLAMA_HOST to localhost here: compose also reads .env.
APP_ENV="development"
LOG_LEVEL="DEBUG"
DATABASE_URL="postgres://raggman:secretpassword@localhost:5432/raggman_db?sslmode=disable"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# Optional: send Answer generation to an OpenAI-compatible provider.
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"
